# Text-to-speech cache: shared by every lesson, rebuildable, never committed.
.audio-cache/

# Build scratch
*.part
__pycache__/

# The generated PDFs and MP3s under lessons/ ARE committed on purpose, so the
# student can download one file without running anything.

# Node tooling for the shared service-worker suite
node_modules/
test-results/
playwright-report/

# Autopilot lane state and logs
.claude/autopilot/state/
.claude/autopilot/logs/
